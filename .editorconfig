root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true

[*.{md,yml,yaml,toml}]
indent_size = 2

# Preserve the bytes of existing frozen sources and artifacts. New files use LF.
[{.github/**,scripts/**,docs/**,README.md,CONTRIBUTING.md,SECURITY.md}]
end_of_line = lf
